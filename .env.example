# === Servidor (nunca exposto ao browser) ===

# URL base da API Laravel, com o prefixo /api se aplicável.
API_BASE_URL=http://localhost:8000/api

# Nome do cookie httpOnly que guarda o token de sessão.
SESSION_COOKIE_NAME=granito_session

# Duração máxima da sessão, em segundos (default: 7 dias).
SESSION_MAX_AGE=604800

# Janela de inatividade, em segundos: sem atividade nesse intervalo o usuário
# volta ao login. É deslizante (renova a cada requisição autenticada). Default: 1h.
SESSION_IDLE_TIMEOUT=3600

# Timeout padrão das chamadas à API, em ms.
API_TIMEOUT_MS=15000

# === Público (embutido no bundle, prefixo NEXT_PUBLIC_) ===

NEXT_PUBLIC_APP_NAME=Granito

# Espelho de SESSION_IDLE_TIMEOUT para o redirect proativo no cliente.
# Mantenha em sincronia com o valor do servidor.
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT=3600
